generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model assinatura_socio {
  id          Int               @id @default(autoincrement())
  jogador_id  Int
  data_inicio DateTime          @db.Timestamptz(6)
  data_fim    DateTime?         @db.Timestamptz(6)
  status      status_assinatura
  plano       String?           @db.VarChar(50)
  jogador     jogador           @relation(fields: [jogador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model auditoria {
  id          Int      @id @default(autoincrement())
  usuario_id  Int?
  acao        String   @db.VarChar(100)
  entidade    String?  @db.VarChar(50)
  entidade_id Int?
  detalhes    String?
  data_acao   DateTime @default(now()) @db.Timestamptz(6)
  usuario     usuario? @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuario_id], map: "idx_auditoria_usuario")
}

model avaliacao_jogador {
  id                                              Int      @id @default(autoincrement())
  partida_id                                      Int
  avaliador_id                                    Int
  avaliado_id                                     Int
  nota                                            Decimal  @db.Decimal(3, 1)
  comentario                                      String?
  data_avaliacao                                  DateTime @default(now()) @db.Timestamptz(6)
  jogador_avaliacao_jogador_avaliado_idTojogador  jogador  @relation("avaliacao_jogador_avaliado_idTojogador", fields: [avaliado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jogador_avaliacao_jogador_avaliador_idTojogador jogador  @relation("avaliacao_jogador_avaliador_idTojogador", fields: [avaliador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partida                                         partida  @relation(fields: [partida_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model caixa_grupo {
  id                   Int                    @id @default(autoincrement())
  grupo_id             Int
  saldo_atual          Decimal?               @default(0.0) @db.Decimal(10, 2)
  grupo                grupo                  @relation(fields: [grupo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transacao_financeira transacao_financeira[]
}

model carteira_jogador {
  id            Int         @id @default(autoincrement())
  jogador_id    Int
  grupo_id      Int
  saldo_devedor Decimal?    @default(0.0) @db.Decimal(10, 2)
  grupo         grupo       @relation(fields: [grupo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jogador       jogador     @relation(fields: [jogador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pagamento     pagamento[]
}

model confirmacao_presenca {
  partida_id       Int
  jogador_id       Int
  status_presenca  status_presenca? @default(nao_confirmado)
  data_confirmacao DateTime?        @db.Timestamptz(6)
  jogador          jogador          @relation(fields: [jogador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  partida          partida          @relation(fields: [partida_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([partida_id, jogador_id])
  @@index([jogador_id], map: "idx_confirmacao_jogador")
  @@index([partida_id], map: "idx_confirmacao_partida")
}

model destaque_partida {
  id            Int           @id @default(autoincrement())
  partida_id    Int
  jogador_id    Int
  tipo_destaque tipo_destaque
  jogador       jogador       @relation(fields: [jogador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partida       partida       @relation(fields: [partida_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model evento_partida {
  id             Int         @id @default(autoincrement())
  partida_id     Int
  jogador_id     Int
  tipo_evento    tipo_evento
  time_evento    Int?
  minuto_partida Int?
  descricao      String?
  jogador        jogador     @relation(fields: [jogador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partida        partida     @relation(fields: [partida_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  time           time?       @relation(fields: [time_evento], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model grupo {
  id               Int                @id @default(autoincrement())
  nome             String             @db.VarChar(255)
  descricao        String?
  administrador_id Int
  data_criacao     DateTime           @default(now()) @db.Timestamptz(6)
  localizacao      String?            @db.VarChar(255)
  regras           String?
  ativo            Boolean?           @default(true)
  caixa_grupo      caixa_grupo[]
  carteira_jogador carteira_jogador[]
  usuario          usuario            @relation(fields: [administrador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membro_grupo     membro_grupo[]
  notificacao      notificacao[]
  partida          partida[]
}

model jogador {
  id                                                        Int                    @id
  posicao_preferida                                         String?                @db.VarChar(50)
  overall                                                   Decimal?               @default(0.0) @db.Decimal(3, 1)
  vitorias                                                  Int?                   @default(0)
  derrotas                                                  Int?                   @default(0)
  empates                                                   Int?                   @default(0)
  presencas                                                 Int?                   @default(0)
  ausencias                                                 Int?                   @default(0)
  assiduidade                                               Decimal?               @default(0.0) @db.Decimal(5, 2)
  media_nota                                                Decimal?               @default(0.0) @db.Decimal(3, 1)
  bio                                                       String?
  avatar_url                                                String?                @db.VarChar(255)
  assinatura_socio                                          assinatura_socio[]
  avaliacao_jogador_avaliacao_jogador_avaliado_idTojogador  avaliacao_jogador[]    @relation("avaliacao_jogador_avaliado_idTojogador")
  avaliacao_jogador_avaliacao_jogador_avaliador_idTojogador avaliacao_jogador[]    @relation("avaliacao_jogador_avaliador_idTojogador")
  carteira_jogador                                          carteira_jogador[]
  confirmacao_presenca                                      confirmacao_presenca[]
  destaque_partida                                          destaque_partida[]
  evento_partida                                            evento_partida[]
  usuario                                                   usuario                @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jogador_time                                              jogador_time[]
  membro_grupo                                              membro_grupo[]
}

model jogador_time {
  time_id        Int
  jogador_id     Int
  posicao_jogada String? @db.VarChar(50)
  jogador        jogador @relation(fields: [jogador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  time           time    @relation(fields: [time_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([time_id, jogador_id])
}

model membro_grupo {
  grupo_id     Int
  jogador_id   Int
  data_entrada DateTime       @default(now()) @db.Timestamptz(6)
  status       status_membro? @default(pendente)
  papel        papel_grupo?   @default(membro)
  grupo        grupo          @relation(fields: [grupo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jogador      jogador        @relation(fields: [jogador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([grupo_id, jogador_id])
}

model notificacao {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  grupo_id   Int?
  partida_id Int?
  titulo     String   @db.VarChar(255)
  mensagem   String
  tipo       String?  @db.VarChar(50)
  lida       Boolean? @default(false)
  data_envio DateTime @default(now()) @db.Timestamptz(6)
  grupo      grupo?   @relation(fields: [grupo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partida    partida? @relation(fields: [partida_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario    usuario  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuario_id], map: "idx_notificacao_usuario")
}

model pagamento {
  id                      Int                   @id @default(autoincrement())
  carteira_jogador_id     Int
  valor_pago              Decimal               @db.Decimal(10, 2)
  data_pagamento          DateTime              @default(now()) @db.Timestamptz(6)
  metodo_pagamento        String?               @db.VarChar(50)
  transacao_financeira_id Int?
  carteira_jogador        carteira_jogador      @relation(fields: [carteira_jogador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transacao_financeira    transacao_financeira? @relation(fields: [transacao_financeira_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model partida {
  id                       Int                    @id @default(autoincrement())
  grupo_id                 Int
  data_hora                DateTime               @db.Timestamptz(6)
  local                    String?                @db.VarChar(255)
  duracao_estimada_minutos Int?
  status                   status_partida?        @default(agendada)
  limite_jogadores         Int?
  valor_pelada             Decimal?               @default(0.0) @db.Decimal(10, 2)
  created_at               DateTime               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?              @db.Timestamptz(6)
  avaliacao_jogador        avaliacao_jogador[]
  confirmacao_presenca     confirmacao_presenca[]
  destaque_partida         destaque_partida[]
  evento_partida           evento_partida[]
  notificacao              notificacao[]
  grupo                    grupo                  @relation(fields: [grupo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  time                     time[]

  @@index([grupo_id], map: "idx_partida_grupo")
}

model time {
  id              Int              @id @default(autoincrement())
  partida_id      Int
  nome_time       String?          @db.VarChar(255)
  pontuacao_final Int?             @default(0)
  evento_partida  evento_partida[]
  jogador_time    jogador_time[]
  partida         partida          @relation(fields: [partida_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model transacao_financeira {
  id             Int            @id @default(autoincrement())
  caixa_grupo_id Int
  tipo_transacao tipo_transacao
  descricao      String?
  valor          Decimal        @db.Decimal(10, 2)
  data_transacao DateTime       @default(now()) @db.Timestamptz(6)
  responsavel_id Int
  pagamento      pagamento[]
  caixa_grupo    caixa_grupo    @relation(fields: [caixa_grupo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario        usuario        @relation(fields: [responsavel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model usuario {
  id                   Int                    @id @default(autoincrement())
  nome                 String                 @db.VarChar(255)
  email                String                 @unique @db.VarChar(255)
  senha_hash           String                 @db.VarChar(255)
  data_cadastro        DateTime               @default(now()) @db.Timestamptz(6)
  ativo                Boolean?               @default(true)
  auditoria            auditoria[]
  grupo                grupo[]
  jogador              jogador?
  notificacao          notificacao[]
  transacao_financeira transacao_financeira[]

  @@index([email], map: "idx_usuario_email")
}

model vantagem_socio {
  id            Int           @id @default(autoincrement())
  nome          String        @db.VarChar(255)
  descricao     String?
  tipo_vantagem tipo_vantagem
}

enum papel_grupo {
  admin
  membro
}

enum status_assinatura {
  ativo
  inativo
  cancelado
}

enum status_membro {
  ativo
  pendente
  removido
}

enum status_partida {
  agendada
  em_andamento
  finalizada
  cancelada
}

enum status_presenca {
  confirmado
  nao_confirmado
  fila_espera
}

enum tipo_destaque {
  melhor_atacante
  melhor_defensor
  melhor_levantador
  melhor_bloqueador
  melhor_saque
  bola_murcha
}

enum tipo_evento {
  ponto_ataque
  ponto_bloqueio
  ponto_saque
  erro_ataque
  erro_saque
  erro_recepcao
  defesa
  substituicao
  cartao_amarelo
  cartao_vermelho
}

enum tipo_transacao {
  receita
  despesa
}

enum tipo_vantagem {
  estatisticas_avancadas
  comparacao_jogadores
  vetar_nota
  clube_descontos
  experiencias_exclusivas
}
